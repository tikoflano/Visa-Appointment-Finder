# Copy to .env and fill in. ./run.sh loads .env automatically (shell exports win).
# Do not commit .env — it is gitignored.

# Docker publish
# HOST_BIND=127.0.0.1
# PORT=3000
# OPENWA=1

# Public Cloudflare Tunnel / HTTPS
# COOKIE_SECURE=true
# PUBLIC_BASE_URL=https://visa.example.com
# ADMIN_IP_ALLOWLIST=203.0.113.10,203.0.113.0/24

# Cloudflare Turnstile (free). Create a widget for your Tunnel hostname.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_REQUIRED=true
